<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="main-screen" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.blen.launcher.controller.MainScreenController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header-bar">
            <padding>
                <Insets bottom="10.0" left="24.0" right="24.0" top="10.0"/>
            </padding>
            <Label text="Blen Launcher" styleClass="app-title-small"/>
            <Label text="v1.1.0" styleClass="badge-version"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ImageView fx:id="avatarImage" fitHeight="28.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true"/>
            <Label fx:id="welcomeLabel" styleClass="user-name" text="Welcome"/>
            <Button onAction="#handleLogout" styleClass="header-button" text="Switch User"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="14.0">
            <padding>
                <Insets bottom="18.0" left="36.0" right="36.0" top="16.0"/>
            </padding>

            <!-- Version and RAM Row -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="controls-row">
                <Label styleClass="field-label" text="Version:"/>
                <ComboBox fx:id="versionCombo" prefWidth="240.0" promptText="Select version"/>
                <Button onAction="#handleRefreshVersions" styleClass="small-icon-button" text="⟳"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label styleClass="field-label" text="RAM:"/>
                <ComboBox fx:id="ramCombo" prefWidth="110.0"/>
                <Button onAction="#handleOpenGameDir" styleClass="small-button" text="📁 Folder"/>
            </HBox>

            <!-- Performance and Smooth Mods Toggles -->
            <HBox alignment="CENTER" spacing="24.0" styleClass="opt-row">
                <CheckBox fx:id="smoothOptCheck" selected="true" styleClass="opt-checkbox"
                          text="⚡ Ultra Smooth JVM &amp; G1GC Optimization"/>
                <CheckBox fx:id="smoothModsCheck" selected="true" styleClass="opt-checkbox"
                          text="🚀 Smooth Mods (Fabric + Sodium Boost)"/>
            </HBox>

            <!-- Launch Button -->
            <Button fx:id="launchButton" onAction="#handleLaunch" prefWidth="300.0"
                    styleClass="launch-button" text="▶  Play Minecraft"/>

            <!-- Status Indicator -->
            <HBox alignment="CENTER" spacing="10.0">
                <ProgressIndicator fx:id="progressIndicator" prefHeight="18.0" prefWidth="18.0" visible="false"/>
                <Label fx:id="statusLabel" styleClass="status-text" text="Ready to play"/>
            </HBox>

            <!-- Logs Section Header -->
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label styleClass="logs-title" text="Game Logs"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#handleClearLogs" styleClass="clear-button" text="Clear"/>
            </HBox>

            <!-- Logs Output -->
            <TextArea fx:id="logsArea" editable="false" prefRowCount="6" styleClass="logs-area" wrapText="true"/>
        </VBox>
    </center>

</BorderPane>
